NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081
# Keep false to run the demo/API without SQL Server or before local migration review.
PERSISTENCE_ENABLED=false
# Explicit opt-in, loopback only; hidden outside development.
DB_DIAGNOSTICS_ENABLED=false
# Runtime identity: DML permissions only. Replace the placeholder locally; never commit .env.
# DATABASE_URL="sqlserver://127.0.0.1:1433;database=OminiDB;user=omini_app;password={REPLACE_LOCALLY};encrypt=true;trustServerCertificate=true"
