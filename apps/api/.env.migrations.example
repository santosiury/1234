# Copy to .env.migrations ONLY on the Windows machine that runs migrations.
# Never inject this identity into the API, mobile or runtime .env.
# Phase 2.6: status AND deploy accept only this isolated test target.
# Production requires separate authorization and an explicitly reviewed configuration.
MIGRATION_DATABASE_URL="sqlserver://127.0.0.1:15433;database=OminiDB;user=omini_migrator;password={REPLACE_LOCALLY};encrypt=true;trustServerCertificate=true"
