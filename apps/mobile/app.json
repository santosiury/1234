{
  "expo": {
    "name": "Omini",
    "slug": "omini",
    "version": "0.1.0",
    "scheme": "omini",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101010",
          "image": "./assets/brand/splash-lockup.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#101010",
            "image": "./assets/brand/splash-lockup.png"
          },
          "android": {
            "imageWidth": 180
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omini.app"
    },
    "android": {
      "package": "com.omini.app"
    },
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#101010"
  }
}
