{
  "name": "omini",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @omini/api",
    "dev:mobile": "npm run start -w @omini/mobile --",
    "build:api": "npm run build -w @omini/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "check:routes": "node scripts/check-routes.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "expo-router": "58.0.30",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
